{
  "name": "deleted-audit",
  "description": "퀘스트가 지워지기 직전에 그 내용을 deleted.log 에 남깁니다. 지워진 뒤에는 볼 수 없는 것을 미리 기록해 둡니다.",
  "on": ["pre:quest.deleted"],
  "scope": ["cli", "gui", "server"],
  "action": {
    "run": {
      "command": "sh",
      "args": ["-c", "cat >> deleted.log; echo >> deleted.log"],
      "timeout_ms": 3000
    }
  },
  "script": "transform.rhai"
}
