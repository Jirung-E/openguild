{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openguild",
  "version": "0.1.0",
  "identifier": "io.openguild.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "./frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "openguild",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Quest-based local-first project tracker",
    "longDescription": "openguild — a local-first desktop app that tracks personal and team work using a Guild / Quest model.",
    "fileAssociations": [
      {
        "ext": ["guild"],
        "name": "openguild Guild File",
        "description": "openguild guild marker file. Double-click to open the guild in openguild.",
        "role": "Editor",
        "mimeType": "application/x-openguild"
      }
    ]
  }
}
